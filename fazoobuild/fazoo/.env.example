# Copie para .env se quiser rodar localmente (o .env nunca vai para o GitHub).
# Texto longo e aleatório. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=troque-por-um-texto-longo-e-aleatorio

# Produção (Vercel + Neon): preenchida automaticamente pela integração de banco.
# Local: deixe em branco e o app usa um arquivo SQLite em ./data/fazoo.db
DATABASE_URL=
